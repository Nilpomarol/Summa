activeBudgets:
SELECT
    budgets.id,
    budgets.scope,
    budgets.category_id,
    categories.name AS category_name,
    categories.icon AS category_icon,
    categories.color AS category_color,
    budgets.trip_id,
    trips.name AS trip_name,
    budgets.period,
    budgets.limit_amount_cents,
    budgets.alert_threshold_percent,
    budgets.include_trip_expenses,
    budgets.include_extraordinary_expenses,
    budgets.created_at,
    budgets.updated_at,
    budgets.archived_at
FROM budgets
LEFT JOIN categories
    ON categories.id = budgets.category_id
   AND categories.archived_at IS NULL
LEFT JOIN trips
    ON trips.id = budgets.trip_id
   AND trips.archived_at IS NULL
WHERE budgets.archived_at IS NULL
  AND (
      (budgets.scope = 'category' AND categories.id IS NOT NULL) OR
      (budgets.scope = 'trip' AND trips.id IS NOT NULL) OR
      budgets.scope = 'overall_month'
  )
ORDER BY
    CASE budgets.scope WHEN 'overall_month' THEN 0 WHEN 'category' THEN 1 ELSE 2 END ASC,
    CASE budgets.period WHEN 'monthly' THEN 0 WHEN 'yearly' THEN 1 ELSE 2 END ASC,
    lower(COALESCE(categories.name, trips.name, '')) ASC;

budgetById:
SELECT
    budgets.id,
    budgets.scope,
    budgets.category_id,
    categories.name AS category_name,
    categories.icon AS category_icon,
    categories.color AS category_color,
    budgets.trip_id,
    trips.name AS trip_name,
    budgets.period,
    budgets.limit_amount_cents,
    budgets.alert_threshold_percent,
    budgets.include_trip_expenses,
    budgets.include_extraordinary_expenses,
    budgets.created_at,
    budgets.updated_at,
    budgets.archived_at
FROM budgets
LEFT JOIN categories
    ON categories.id = budgets.category_id
   AND categories.archived_at IS NULL
LEFT JOIN trips
    ON trips.id = budgets.trip_id
   AND trips.archived_at IS NULL
WHERE budgets.id = :id
  AND budgets.archived_at IS NULL;

-- A budget on a parent-with-children (container) rolls up: it counts spend posted to the
-- parent itself and to any of its active children.
budgetActualForCategory:
SELECT COALESCE(SUM(amount_cents), 0) AS actual_cents
FROM v_actual_expense
WHERE (category_id = :category_id
       OR category_id IN (SELECT id FROM categories
                          WHERE parent_id = :category_id AND archived_at IS NULL))
  AND date >= :from_date
  AND date <= :to_date
  AND (:include_trip_expenses = 1 OR trip_id IS NULL)
  AND (:include_extraordinary_expenses = 1 OR is_one_time = 0);

budgetActualForTrip:
SELECT COALESCE(SUM(amount_cents), 0) AS actual_cents
FROM v_actual_expense
WHERE trip_id = :trip_id
  AND date >= :from_date
  AND date <= :to_date;

budgetActualOverall:
SELECT COALESCE(SUM(amount_cents), 0) AS actual_cents
FROM v_actual_expense
WHERE date >= :from_date
  AND date <= :to_date
  AND (:include_trip_expenses = 1 OR trip_id IS NULL)
  AND (:include_extraordinary_expenses = 1 OR is_one_time = 0);

insertBudget:
INSERT INTO budgets(
    id,
    scope,
    category_id,
    trip_id,
    period,
    limit_amount_cents,
    alert_threshold_percent,
    include_trip_expenses,
    include_extraordinary_expenses,
    created_at,
    updated_at
) VALUES (
    :id,
    :scope,
    :category_id,
    :trip_id,
    :period,
    :limit_amount_cents,
    :alert_threshold_percent,
    :include_trip_expenses,
    :include_extraordinary_expenses,
    :created_at,
    :updated_at
);

updateBudget:
UPDATE budgets
SET
    scope = :scope,
    category_id = :category_id,
    trip_id = :trip_id,
    period = :period,
    limit_amount_cents = :limit_amount_cents,
    alert_threshold_percent = :alert_threshold_percent,
    include_trip_expenses = :include_trip_expenses,
    include_extraordinary_expenses = :include_extraordinary_expenses,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archiveBudget:
UPDATE budgets
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

restoreBudget:
UPDATE budgets
SET
    archived_at = NULL,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at = :archived_at;

-- The monthly plan's spending over [from_date, to_date], split by category and by whether it came
-- from a recurring payment (a movement made from a template, or a refund of one). The rows
-- partition canonical actual expense under the plan's inclusion rules exactly, so the plan's parts
-- always add up to the overall figure.
planSpend:
SELECT
    actual.category_id,
    CASE
        WHEN recorded.template_id IS NOT NULL OR refunded_expense.template_id IS NOT NULL THEN 1
        ELSE 0
    END AS recurring,
    COALESCE(SUM(actual.amount_cents), 0) AS actual_cents
FROM v_actual_expense AS actual
JOIN movements AS recorded
    ON recorded.id = actual.source_id
LEFT JOIN movements AS refunded_expense
    ON refunded_expense.id = recorded.refunds_expense_id
WHERE actual.date >= :from_date
  AND actual.date <= :to_date
  AND (:include_trip_expenses = 1 OR actual.trip_id IS NULL)
  AND (:include_extraordinary_expenses = 1 OR actual.is_one_time = 0)
GROUP BY actual.category_id, recurring;

-- The owner's canonical income over [from_date, to_date], split by whether it came from a
-- recurring income: what the plan's expected saving starts from.
planIncome:
SELECT
    CASE WHEN recorded.template_id IS NOT NULL THEN 1 ELSE 0 END AS recurring,
    COALESCE(SUM(income.amount_cents), 0) AS actual_cents
FROM v_actual_income AS income
JOIN movements AS recorded
    ON recorded.id = income.source_id
WHERE income.date >= :from_date
  AND income.date <= :to_date
GROUP BY recurring;

-- A category's parent and its live children: a plan compartment may not overlap another.
categoryParent:
SELECT parent_id FROM categories WHERE id = :id;

categoryChildren:
SELECT id FROM categories WHERE parent_id = :id AND archived_at IS NULL;

-- A budget as stored, archived or not: what its plan version is written from.
budgetVersionSource:
SELECT category_id, period, limit_amount_cents, include_trip_expenses, include_extraordinary_expenses, archived_at
FROM budgets
WHERE id = :id;

budgetVersionCount:
SELECT COUNT(*) FROM budget_versions WHERE budget_id = :budget_id;

upsertBudgetVersion:
INSERT OR REPLACE INTO budget_versions(
    budget_id,
    from_month,
    category_id,
    limit_amount_cents,
    include_trip_expenses,
    include_extraordinary_expenses
) VALUES (
    :budget_id,
    :from_month,
    :category_id,
    :limit_amount_cents,
    :include_trip_expenses,
    :include_extraordinary_expenses
);

-- The monthly plan as :month had it: each budget's latest version from that month or before, left
-- out when that version took it out of the plan. A month before the plan's first takes the plan's
-- first shape, so there is always something to measure it against.
budgetsAsOfMonth:
SELECT
    budgets.id,
    budgets.scope,
    version.category_id,
    categories.name AS category_name,
    categories.icon AS category_icon,
    categories.color AS category_color,
    version.limit_amount_cents,
    version.include_trip_expenses,
    version.include_extraordinary_expenses
FROM budget_versions AS version
JOIN budgets
    ON budgets.id = version.budget_id
LEFT JOIN categories
    ON categories.id = version.category_id
WHERE version.from_month = (
        SELECT MAX(candidate.from_month)
        FROM budget_versions AS candidate
        WHERE candidate.budget_id = version.budget_id
          AND candidate.from_month <= CASE
                WHEN :month < (SELECT MIN(first.from_month) FROM budget_versions AS first)
                    THEN (SELECT MIN(first.from_month) FROM budget_versions AS first)
                ELSE :month
              END
      )
  AND version.limit_amount_cents IS NOT NULL
ORDER BY
    CASE budgets.scope WHEN 'overall_month' THEN 0 ELSE 1 END ASC,
    lower(COALESCE(categories.name, '')) ASC;
