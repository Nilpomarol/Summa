activePeople:
SELECT
    people.id,
    people.name,
    people.avatar,
    people.color,
    people.notes,
    people.created_at,
    people.updated_at,
    people.archived_at,
    v_person_balance.balance_cents
FROM people
JOIN v_person_balance
    ON v_person_balance.person_id = people.id
WHERE people.archived_at IS NULL
ORDER BY
    CASE WHEN v_person_balance.balance_cents = 0 THEN 1 ELSE 0 END ASC,
    abs(v_person_balance.balance_cents) DESC,
    lower(people.name) ASC;

personById:
SELECT
    people.id,
    people.name,
    people.avatar,
    people.color,
    people.notes,
    people.created_at,
    people.updated_at,
    people.archived_at,
    v_person_balance.balance_cents
FROM people
JOIN v_person_balance
    ON v_person_balance.person_id = people.id
WHERE people.id = :id
  AND people.archived_at IS NULL;

personBalanceItems:
SELECT
    source_id,
    source_type,
    source_date,
    title,
    category_id,
    category_name,
    effect_cents
FROM (
    SELECT
        movements.id AS source_id,
        'user_paid' AS source_type,
        movements.date AS source_date,
        COALESCE(NULLIF(movements.name, ''), NULLIF(movements.payee, ''), NULLIF(movements.notes, '')) AS title,
        movements.category_id AS category_id,
        categories.name AS category_name,
        split_lines.owed_amount_cents AS effect_cents
    FROM split_lines
    JOIN splits
        ON splits.id = split_lines.split_id
    JOIN movements
        ON movements.id = splits.movement_id
    LEFT JOIN categories
        ON categories.id = movements.category_id
    WHERE split_lines.person_id = :person_id
      AND split_lines.participant_kind = 'person'
      AND splits.payer_person_id IS NULL
      AND movements.archived_at IS NULL
      AND splits.archived_at IS NULL
      AND split_lines.archived_at IS NULL

    UNION ALL

    SELECT
        splits.id AS source_id,
        'person_paid' AS source_type,
        splits.date AS source_date,
        NULLIF(splits.description, '') AS title,
        splits.category_id AS category_id,
        categories.name AS category_name,
        -split_lines.owed_amount_cents AS effect_cents
    FROM splits
    JOIN split_lines
        ON split_lines.split_id = splits.id
    LEFT JOIN categories
        ON categories.id = splits.category_id
    WHERE splits.payer_person_id = :person_id
      AND splits.movement_id IS NULL
      AND split_lines.participant_kind = 'user'
      AND splits.archived_at IS NULL
      AND split_lines.archived_at IS NULL

    UNION ALL

    SELECT
        movements.id AS source_id,
        'settlement_in' AS source_type,
        movements.date AS source_date,
        COALESCE(NULLIF(movements.name, ''), NULLIF(movements.notes, '')) AS title,
        CAST(NULL AS TEXT) AS category_id,
        CAST(NULL AS TEXT) AS category_name,
        -movements.amount_cents AS effect_cents
    FROM movements
    WHERE movements.type = 'settlement'
      AND movements.person_id = :person_id
      AND movements.settlement_direction = 'person_to_user'
      AND movements.archived_at IS NULL

    UNION ALL

    SELECT
        movements.id AS source_id,
        'settlement_out' AS source_type,
        movements.date AS source_date,
        COALESCE(NULLIF(movements.name, ''), NULLIF(movements.notes, '')) AS title,
        CAST(NULL AS TEXT) AS category_id,
        CAST(NULL AS TEXT) AS category_name,
        movements.amount_cents AS effect_cents
    FROM movements
    WHERE movements.type = 'settlement'
      AND movements.person_id = :person_id
      AND movements.settlement_direction = 'user_to_person'
      AND movements.archived_at IS NULL
)
ORDER BY source_date DESC, source_type ASC, source_id ASC;

insertPerson:
INSERT INTO people(
    id,
    name,
    avatar,
    color,
    notes,
    created_at,
    updated_at
) VALUES (
    :id,
    :name,
    :avatar,
    :color,
    :notes,
    :created_at,
    :updated_at
);

updatePerson:
UPDATE people
SET
    name = :name,
    avatar = :avatar,
    color = :color,
    notes = :notes,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archivePerson:
UPDATE people
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;
