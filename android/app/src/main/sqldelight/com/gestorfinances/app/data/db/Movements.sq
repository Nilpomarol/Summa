activeMovementSummaries:
SELECT * FROM v_movement_summary
ORDER BY date DESC, created_at DESC;

activeMovementSummariesForAccount:
SELECT * FROM v_movement_summary
WHERE account_id = :account_id OR dest_account_id = :account_id
ORDER BY date DESC, created_at DESC;

movementById:
SELECT * FROM v_movement_summary
WHERE id = :id;

activeMovementSummariesForCategory:
SELECT * FROM v_movement_summary
WHERE category_id = :category_id
ORDER BY date DESC, created_at DESC;

accountFlowForAccount:
SELECT
    v_account_flow.account_id,
    v_account_flow.date,
    v_account_flow.movement_id,
    v_account_flow.delta_cents,
    movements.type,
    movements.name,
    movements.payee,
    movements.notes,
    movements.category_id,
    categories.name AS category_name,
    movements.account_id AS origin_account_id,
    origin_accounts.name AS origin_account_name,
    movements.dest_account_id AS destination_account_id,
    destination_accounts.name AS destination_account_name
FROM v_account_flow
JOIN movements
    ON movements.id = v_account_flow.movement_id
JOIN accounts AS origin_accounts
    ON origin_accounts.id = movements.account_id
LEFT JOIN accounts AS destination_accounts
    ON destination_accounts.id = movements.dest_account_id
LEFT JOIN categories
    ON categories.id = movements.category_id
WHERE v_account_flow.account_id = :account_id
ORDER BY v_account_flow.date DESC, movements.created_at DESC;

movementCountsByTemplate:
SELECT
    template_id,
    COUNT(*) AS movement_count
FROM v_movement_summary
WHERE template_id IS NOT NULL
GROUP BY template_id;

movementsForCategory:
SELECT
    v_account_flow.account_id,
    v_account_flow.date,
    v_account_flow.movement_id,
    v_account_flow.delta_cents,
    movements.type,
    movements.name,
    movements.payee,
    movements.notes,
    movements.category_id,
    categories.name AS category_name,
    movements.account_id AS origin_account_id,
    origin_accounts.name AS origin_account_name,
    movements.dest_account_id AS destination_account_id,
    destination_accounts.name AS destination_account_name
FROM v_account_flow
JOIN movements
    ON movements.id = v_account_flow.movement_id
JOIN accounts AS origin_accounts
    ON origin_accounts.id = movements.account_id
LEFT JOIN accounts AS destination_accounts
    ON destination_accounts.id = movements.dest_account_id
LEFT JOIN categories
    ON categories.id = movements.category_id
WHERE movements.category_id = :category_id
ORDER BY movements.date DESC, movements.created_at DESC;

insertMovement:
INSERT INTO movements(
    id,
    type,
    amount_cents,
    date,
    account_id,
    dest_account_id,
    name,
    payee,
    notes,
    is_one_time,
    category_id,
    trip_id,
    tag_id,
    template_id,
    created_at,
    updated_at
) VALUES (
    :id,
    :type,
    :amount_cents,
    :date,
    :account_id,
    :dest_account_id,
    :name,
    :payee,
    :notes,
    :is_one_time,
    :category_id,
    :trip_id,
    :tag_id,
    :template_id,
    :created_at,
    :updated_at
);

refundsForExpense:
SELECT
    movements.id,
    movements.amount_cents,
    movements.date,
    movements.actual_refund_cents,
    movements.category_id,
    categories.name AS category_name,
    movements.notes
FROM movements
LEFT JOIN categories
    ON categories.id = movements.category_id
WHERE movements.type = 'refund'
  AND movements.refunds_expense_id = :expense_id
  AND movements.archived_at IS NULL
ORDER BY movements.date DESC, movements.created_at DESC;

insertRefund:
INSERT INTO movements(
    id,
    type,
    amount_cents,
    date,
    account_id,
    name,
    payee,
    notes,
    category_id,
    refunds_expense_id,
    actual_refund_cents,
    created_at,
    updated_at
) VALUES (
    :id,
    'refund',
    :amount_cents,
    :date,
    :account_id,
    :name,
    :payee,
    :notes,
    :category_id,
    :refunds_expense_id,
    :actual_refund_cents,
    :created_at,
    :updated_at
);

insertSettlement:
INSERT INTO movements(
    id,
    type,
    amount_cents,
    date,
    account_id,
    notes,
    category_id,
    person_id,
    settlement_direction,
    created_at,
    updated_at
) VALUES (
    :id,
    'settlement',
    :amount_cents,
    :date,
    :account_id,
    :notes,
    NULL,
    :person_id,
    :settlement_direction,
    :created_at,
    :updated_at
);

updateMovement:
UPDATE movements
SET
    type = :type,
    amount_cents = :amount_cents,
    date = :date,
    account_id = :account_id,
    dest_account_id = :dest_account_id,
    name = :name,
    payee = :payee,
    notes = :notes,
    is_one_time = :is_one_time,
    category_id = :category_id,
    trip_id = :trip_id,
    tag_id = :tag_id,
    template_id = :template_id,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archiveMovement:
UPDATE movements
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

linkToTemplate:
UPDATE movements
SET
    template_id = :template_id,
    updated_at = :updated_at
WHERE id IN :ids
  AND archived_at IS NULL;

unlinkAllForTemplate:
UPDATE movements
SET
    template_id = NULL,
    updated_at = :updated_at
WHERE template_id = :template_id
  AND archived_at IS NULL;
