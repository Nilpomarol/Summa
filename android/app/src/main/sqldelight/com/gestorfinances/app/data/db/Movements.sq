activeMovementSummaries:
SELECT * FROM v_movement_summary
ORDER BY date DESC, created_at DESC;

-- An account's own ledger: exactly the movements that changed its balance, each with what it did
-- to that balance, so the list reconciles to the balance instead of recomputing it.
activeMovementSummariesForAccount:
SELECT v_movement_summary.*, v_account_flow.delta_cents AS account_delta_cents
FROM v_movement_summary
JOIN v_account_flow
    ON v_account_flow.movement_id = v_movement_summary.id
   AND v_account_flow.account_id = :account_id
ORDER BY v_movement_summary.date DESC, v_movement_summary.created_at DESC;

movementById:
SELECT * FROM v_movement_summary
WHERE id = :id;

-- A parent-with-children (container) rolls up: its drill-through includes the movements
-- of its active children as well as any posted directly to the parent.
activeMovementSummariesForCategory:
SELECT * FROM v_movement_summary
WHERE (category_id = :category_id
       OR category_id IN (SELECT id FROM categories
                          WHERE parent_id = :category_id AND archived_at IS NULL))
ORDER BY date DESC, created_at DESC;

-- The writing repository allows an income allocation only into a shared account.
accountOwnershipKind:
SELECT ownership_kind FROM accounts WHERE id = :id;

movementCountsByTemplate:
SELECT
    template_id,
    COUNT(*) AS movement_count
FROM v_movement_summary
WHERE template_id IS NOT NULL
GROUP BY template_id;

insertMovement:
INSERT INTO movements(
    id,
    type,
    amount_cents,
    date,
    account_id,
    dest_account_id,
    name,
    payee,
    notes,
    is_one_time,
    category_id,
    trip_id,
    tag_id,
    template_id,
    expense_funding,
    shared_split_id,
    payer_person_id,
    created_at,
    updated_at
) VALUES (
    :id,
    :type,
    :amount_cents,
    :date,
    :account_id,
    :dest_account_id,
    :name,
    :payee,
    :notes,
    :is_one_time,
    :category_id,
    :trip_id,
    :tag_id,
    :template_id,
    :expense_funding,
    :shared_split_id,
    :payer_person_id,
    :created_at,
    :updated_at
);

refundsForExpense:
SELECT
    movements.id,
    movements.amount_cents,
    movements.date,
    movements.actual_refund_cents,
    movements.category_id,
    categories.name AS category_name,
    movements.notes
FROM movements
LEFT JOIN categories
    ON categories.id = movements.category_id
WHERE movements.type = 'refund'
  AND movements.refunds_expense_id = :expense_id
  AND movements.archived_at IS NULL
ORDER BY movements.date DESC, movements.created_at DESC;

insertRefund:
INSERT INTO movements(
    id,
    type,
    amount_cents,
    date,
    account_id,
    name,
    payee,
    notes,
    refunds_expense_id,
    actual_refund_cents,
    created_at,
    updated_at
) VALUES (
    :id,
    'refund',
    :amount_cents,
    :date,
    :account_id,
    :name,
    :payee,
    :notes,
    :refunds_expense_id,
    :actual_refund_cents,
    :created_at,
    :updated_at
);

insertSettlement:
INSERT INTO movements(
    id,
    type,
    amount_cents,
    date,
    account_id,
    name,
    notes,
    category_id,
    person_id,
    settlement_direction,
    settlement_scope,
    template_id,
    created_at,
    updated_at
) VALUES (
    :id,
    'settlement',
    :amount_cents,
    :date,
    :account_id,
    :name,
    :notes,
    NULL,
    :person_id,
    :settlement_direction,
    :settlement_scope,
    :template_id,
    :created_at,
    :updated_at
);

updateMovement:
UPDATE movements
SET
    type = :type,
    amount_cents = :amount_cents,
    date = :date,
    account_id = :account_id,
    dest_account_id = :dest_account_id,
    name = :name,
    payee = :payee,
    notes = :notes,
    is_one_time = :is_one_time,
    category_id = :category_id,
    trip_id = :trip_id,
    tag_id = :tag_id,
    template_id = :template_id,
    expense_funding = :expense_funding,
    shared_split_id = CASE
        WHEN :expense_funding = 'shared_account' THEN COALESCE(:shared_split_id, shared_split_id)
        ELSE NULL
    END,
    payer_person_id = :payer_person_id,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archiveRefundsForExpense:
UPDATE movements
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE type = 'refund'
  AND refunds_expense_id = :expense_id
  AND archived_at IS NULL;

restoreRefundsForExpense:
UPDATE movements
SET
    archived_at = NULL,
    updated_at = :updated_at
WHERE type = 'refund'
  AND refunds_expense_id = :expense_id
  AND archived_at = :archived_at;

archiveMovement:
UPDATE movements
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

restoreMovement:
UPDATE movements
SET
    archived_at = NULL,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at = :archived_at;

activeMovementIdsForTemplate:
SELECT id
FROM movements
WHERE template_id = :template_id
  AND archived_at IS NULL;

linkToTemplate:
UPDATE movements
SET
    template_id = :template_id,
    updated_at = :updated_at
WHERE id IN :ids
  AND archived_at IS NULL;

unlinkAllForTemplate:
UPDATE movements
SET
    template_id = NULL,
    updated_at = :updated_at
WHERE template_id = :template_id
  AND archived_at IS NULL;

restoreTemplateLinksAfterDelete:
UPDATE movements
SET
    template_id = :template_id,
    updated_at = :updated_at
WHERE id IN :ids
  AND template_id IS NULL
  AND updated_at = :deleted_at
  AND archived_at IS NULL;
