activeBudgets:
SELECT
    budgets.id,
    budgets.scope,
    budgets.category_id,
    categories.name AS category_name,
    categories.icon AS category_icon,
    categories.color AS category_color,
    budgets.trip_id,
    trips.name AS trip_name,
    budgets.period,
    budgets.limit_amount_cents,
    budgets.alert_threshold_percent,
    budgets.created_at,
    budgets.updated_at,
    budgets.archived_at
FROM budgets
LEFT JOIN categories
    ON categories.id = budgets.category_id
   AND categories.archived_at IS NULL
LEFT JOIN trips
    ON trips.id = budgets.trip_id
   AND trips.archived_at IS NULL
WHERE budgets.archived_at IS NULL
  AND (
      (budgets.scope = 'category' AND categories.id IS NOT NULL) OR
      (budgets.scope = 'trip' AND trips.id IS NOT NULL) OR
      budgets.scope = 'overall_month'
  )
ORDER BY
    CASE budgets.scope WHEN 'overall_month' THEN 0 WHEN 'category' THEN 1 ELSE 2 END ASC,
    CASE budgets.period WHEN 'monthly' THEN 0 WHEN 'yearly' THEN 1 ELSE 2 END ASC,
    lower(COALESCE(categories.name, trips.name, '')) ASC;

budgetById:
SELECT
    budgets.id,
    budgets.scope,
    budgets.category_id,
    categories.name AS category_name,
    categories.icon AS category_icon,
    categories.color AS category_color,
    budgets.trip_id,
    trips.name AS trip_name,
    budgets.period,
    budgets.limit_amount_cents,
    budgets.alert_threshold_percent,
    budgets.created_at,
    budgets.updated_at,
    budgets.archived_at
FROM budgets
LEFT JOIN categories
    ON categories.id = budgets.category_id
   AND categories.archived_at IS NULL
LEFT JOIN trips
    ON trips.id = budgets.trip_id
   AND trips.archived_at IS NULL
WHERE budgets.id = :id
  AND budgets.archived_at IS NULL;

-- A budget on a parent-with-children (container) rolls up: it counts spend posted to the
-- parent itself and to any of its active children.
budgetActualForCategory:
SELECT COALESCE(SUM(amount_cents), 0) AS actual_cents
FROM v_actual_expense
WHERE (category_id = :category_id
       OR category_id IN (SELECT id FROM categories
                          WHERE parent_id = :category_id AND archived_at IS NULL))
  AND date >= :from_date
  AND date <= :to_date;

budgetActualForTrip:
SELECT COALESCE(SUM(amount_cents), 0) AS actual_cents
FROM v_actual_expense
WHERE trip_id = :trip_id
  AND date >= :from_date
  AND date <= :to_date;

budgetActualOverall:
SELECT COALESCE(SUM(amount_cents), 0) AS actual_cents
FROM v_actual_expense
WHERE date >= :from_date
  AND date <= :to_date;

budgetVariableActualForCategory:
SELECT
    COALESCE(SUM(actual.amount_cents), 0) AS actual_cents,
    COUNT(*) AS occurrence_count
FROM v_actual_expense AS actual
LEFT JOIN movements AS recorded
    ON recorded.id = actual.source_id
LEFT JOIN movements AS refunded_expense
    ON refunded_expense.id = recorded.refunds_expense_id
WHERE (recorded.template_id IS NULL OR recorded.id IS NULL)
  AND (refunded_expense.template_id IS NULL OR refunded_expense.id IS NULL)
  AND (actual.category_id = :category_id
       OR actual.category_id IN (SELECT id FROM categories
                                 WHERE parent_id = :category_id AND archived_at IS NULL))
  AND actual.date >= :from_date
  AND actual.date <= :to_date;

budgetVariableActualOverall:
SELECT
    COALESCE(SUM(actual.amount_cents), 0) AS actual_cents,
    COUNT(*) AS occurrence_count
FROM v_actual_expense AS actual
LEFT JOIN movements AS recorded
    ON recorded.id = actual.source_id
LEFT JOIN movements AS refunded_expense
    ON refunded_expense.id = recorded.refunds_expense_id
WHERE (recorded.template_id IS NULL OR recorded.id IS NULL)
  AND (refunded_expense.template_id IS NULL OR refunded_expense.id IS NULL)
  AND actual.date >= :from_date
  AND actual.date <= :to_date;

insertBudget:
INSERT INTO budgets(
    id,
    scope,
    category_id,
    trip_id,
    period,
    limit_amount_cents,
    alert_threshold_percent,
    created_at,
    updated_at
) VALUES (
    :id,
    :scope,
    :category_id,
    :trip_id,
    :period,
    :limit_amount_cents,
    :alert_threshold_percent,
    :created_at,
    :updated_at
);

updateBudget:
UPDATE budgets
SET
    scope = :scope,
    category_id = :category_id,
    trip_id = :trip_id,
    period = :period,
    limit_amount_cents = :limit_amount_cents,
    alert_threshold_percent = :alert_threshold_percent,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archiveBudget:
UPDATE budgets
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;
