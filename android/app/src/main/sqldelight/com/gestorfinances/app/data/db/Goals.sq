-- Savings goals and their dated planning allocations. Progress, remaining amount, and the
-- unallocated part of an account all come from the canonical views; nothing here recomputes them.

activeGoalSummaries:
SELECT
    goals.id,
    goals.name,
    goals.target_amount_cents,
    goals.target_date,
    goals.account_id,
    accounts.name AS account_name,
    accounts.icon AS account_icon,
    accounts.color AS account_color,
    goals.funding_mode,
    goals.status,
    goals.icon,
    goals.color,
    goals.display_order,
    goals.notes,
    goals.created_at,
    goals.updated_at,
    goals.archived_at,
    v_goal_progress.saved_cents,
    v_goal_progress.remaining_cents
FROM goals
JOIN v_goal_progress
    ON v_goal_progress.goal_id = goals.id
LEFT JOIN accounts
    ON accounts.id = goals.account_id
WHERE goals.archived_at IS NULL
ORDER BY
    CASE goals.status WHEN 'active' THEN 0 WHEN 'paused' THEN 1 ELSE 2 END ASC,
    goals.display_order ASC,
    lower(goals.name) ASC;

archivedGoalSummaries:
SELECT
    goals.id,
    goals.name,
    goals.target_amount_cents,
    goals.target_date,
    goals.account_id,
    accounts.name AS account_name,
    accounts.icon AS account_icon,
    accounts.color AS account_color,
    goals.funding_mode,
    goals.status,
    goals.icon,
    goals.color,
    goals.display_order,
    goals.notes,
    goals.created_at,
    goals.updated_at,
    goals.archived_at,
    v_goal_progress.saved_cents,
    v_goal_progress.remaining_cents
FROM goals
JOIN v_goal_progress
    ON v_goal_progress.goal_id = goals.id
LEFT JOIN accounts
    ON accounts.id = goals.account_id
WHERE goals.archived_at IS NOT NULL
ORDER BY goals.archived_at DESC, lower(goals.name) ASC;

goalById:
SELECT
    goals.id,
    goals.name,
    goals.target_amount_cents,
    goals.target_date,
    goals.account_id,
    accounts.name AS account_name,
    accounts.icon AS account_icon,
    accounts.color AS account_color,
    goals.funding_mode,
    goals.status,
    goals.icon,
    goals.color,
    goals.display_order,
    goals.notes,
    goals.created_at,
    goals.updated_at,
    goals.archived_at,
    v_goal_progress.saved_cents,
    v_goal_progress.remaining_cents
FROM goals
JOIN v_goal_progress
    ON v_goal_progress.goal_id = goals.id
LEFT JOIN accounts
    ON accounts.id = goals.account_id
WHERE goals.id = :id;

-- Accounts already dedicated to a goal cannot also host allocations, so the goal form and the
-- allocation form both exclude them. The goal being edited is filtered out by the caller.
dedicatedAccountGoals:
SELECT
    goals.id,
    goals.account_id AS account_id
FROM goals
WHERE goals.funding_mode = 'dedicated_account'
  AND goals.account_id IS NOT NULL
  AND goals.archived_at IS NULL;

accountAllocation:
SELECT
    account_id,
    balance_cents,
    allocated_cents,
    unallocated_cents
FROM v_account_allocation
WHERE account_id = :account_id;

accountAllocations:
SELECT
    v_account_allocation.account_id,
    v_account_allocation.balance_cents,
    v_account_allocation.allocated_cents,
    v_account_allocation.unallocated_cents
FROM v_account_allocation
JOIN accounts
    ON accounts.id = v_account_allocation.account_id
WHERE accounts.archived_at IS NULL;

allocationsForGoal:
SELECT
    goal_allocations.id,
    goal_allocations.goal_id,
    goal_allocations.account_id,
    accounts.name AS account_name,
    goal_allocations.date,
    goal_allocations.amount_cents,
    goal_allocations.notes,
    goal_allocations.created_at,
    goal_allocations.updated_at
FROM goal_allocations
JOIN accounts
    ON accounts.id = goal_allocations.account_id
WHERE goal_allocations.goal_id = :goal_id
  AND goal_allocations.archived_at IS NULL
ORDER BY goal_allocations.date DESC, goal_allocations.created_at DESC;

allocationById:
SELECT
    goal_allocations.id,
    goal_allocations.goal_id,
    goal_allocations.account_id,
    accounts.name AS account_name,
    goal_allocations.date,
    goal_allocations.amount_cents,
    goal_allocations.notes,
    goal_allocations.created_at,
    goal_allocations.updated_at
FROM goal_allocations
JOIN accounts
    ON accounts.id = goal_allocations.account_id
WHERE goal_allocations.id = :id
  AND goal_allocations.archived_at IS NULL;

insertGoal:
INSERT INTO goals(
    id,
    name,
    target_amount_cents,
    target_date,
    account_id,
    funding_mode,
    status,
    icon,
    color,
    display_order,
    notes,
    created_at,
    updated_at
) VALUES (
    :id,
    :name,
    :target_amount_cents,
    :target_date,
    :account_id,
    :funding_mode,
    :status,
    :icon,
    :color,
    :display_order,
    :notes,
    :created_at,
    :updated_at
);

updateGoal:
UPDATE goals
SET
    name = :name,
    target_amount_cents = :target_amount_cents,
    target_date = :target_date,
    account_id = :account_id,
    funding_mode = :funding_mode,
    icon = :icon,
    color = :color,
    display_order = :display_order,
    notes = :notes,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

updateGoalStatus:
UPDATE goals
SET
    status = :status,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archiveGoal:
UPDATE goals
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

restoreGoal:
UPDATE goals
SET
    archived_at = NULL,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at = :archived_at;

insertAllocation:
INSERT INTO goal_allocations(
    id,
    goal_id,
    account_id,
    date,
    amount_cents,
    notes,
    created_at,
    updated_at
) VALUES (
    :id,
    :goal_id,
    :account_id,
    :date,
    :amount_cents,
    :notes,
    :created_at,
    :updated_at
);

updateAllocation:
UPDATE goal_allocations
SET
    account_id = :account_id,
    date = :date,
    amount_cents = :amount_cents,
    notes = :notes,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

archiveAllocation:
UPDATE goal_allocations
SET
    archived_at = :archived_at,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at IS NULL;

restoreAllocation:
UPDATE goal_allocations
SET
    archived_at = NULL,
    updated_at = :updated_at
WHERE id = :id
  AND archived_at = :archived_at;
