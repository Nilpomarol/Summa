-- Gestor finances v2 → v3 migration.
-- Adds tags.category_id (optional subcategory-style association for icon/color inheritance
-- and cross-trip rollup) and tags.trip_type (optional event-type scope: 'trip'/'celebration'/'other',
-- matching TripType.dbValue).
-- The CHECK (trip_id IS NULL OR trip_type IS NULL) is enforced in the fresh-install schema
-- (shared/schema/schema.sql) and mirrored at the app layer (TagsViewModel); SQLite ADD COLUMN
-- cannot introduce a multi-column CHECK here, matching how migration 002 added splits.tag_id
-- without retrofitting a matching CHECK for upgraders either.

ALTER TABLE tags ADD COLUMN category_id TEXT REFERENCES categories(id);
ALTER TABLE tags ADD COLUMN trip_type TEXT;
UPDATE meta SET value = '3' WHERE key = 'schema_version';
