{
  "version": "0.2.0",
  "source": "docs/design.md",
  "description": "Shared design tokens for the Android and Windows finance apps. Values are intentionally platform-neutral.",
  "colors": {
    "neutral": {
      "light": {
        "N0": { "hex": "#FFFDF9", "use": "Surfaces, cards" },
        "N50": { "hex": "#F6F0E5", "use": "App background, table headers" },
        "N100": { "hex": "#EEE6DA", "use": "Track and control backgrounds" },
        "N150": { "hex": "#E7DDD1", "use": "Hairline dividers" },
        "N200": { "hex": "#D8CCBF", "use": "Default borders" },
        "N300": { "hex": "#C7B9AA", "use": "Strong borders" },
        "N400": { "hex": "#A59588", "use": "Disabled text" },
        "N500": { "hex": "#85776D", "use": "Disabled and non-essential text only" },
        "N700": { "hex": "#66584F", "use": "Secondary text and body labels" },
        "N900": { "hex": "#331329", "use": "Primary ink" }
      },
      "dark": {
        "D0": { "hex": "#191317", "use": "App background" },
        "D50": { "hex": "#21191F", "use": "Cards" },
        "D100": { "hex": "#2B222A", "use": "Track and control backgrounds" },
        "D150": { "hex": "#393039", "use": "Dividers and borders" },
        "D200": { "hex": "#4A3D49", "use": "Strong borders and active segment" },
        "D300": { "hex": "#5B4E59", "use": "Dark neutral" },
        "D400": { "hex": "#766874", "use": "Dark neutral" },
        "D500": { "hex": "#958793", "use": "Disabled and non-essential text only" },
        "D700": { "hex": "#C9BAC5", "use": "Secondary text and body labels" },
        "D900": { "hex": "#F5EFEB", "use": "Primary text" }
      }
    },
    "brand": {
      "plumDefault": { "hex": "#765077", "use": "Primary buttons, links, active navigation" },
      "plumHover": { "hex": "#674267", "use": "Hover state" },
      "plumPressed": { "hex": "#542F53", "use": "Pressed state and active navigation text" },
      "plumTint": { "hex": "#F0E7EE", "use": "Light fills and active backgrounds" },
      "plumDark": { "hex": "#C9A5C7", "use": "Primary interaction on dark surfaces" }
    },
    "functional": {
      "incomePositive": {
        "light": "#5E7448",
        "dark": "#B1C891",
        "use": "Income, gains, owed to the user"
      },
      "expense": {
        "light": "#331329",
        "dark": "#F5EFEB",
        "use": "Default expense ink; no separate hue"
      },
      "transfer": {
        "light": "#5F667A",
        "dark": "#AEB4C4",
        "use": "Movements between user accounts"
      },
      "settlement": {
        "light": "#A66F1C",
        "dark": "#E0AE5B",
        "use": "Debt payments"
      },
      "refund": {
        "light": "#277F7D",
        "dark": "#6BC2BE",
        "use": "Linked returns"
      },
      "debtDanger": {
        "light": "#B94E46",
        "dark": "#EF8A80",
        "use": "User owes, over budget, destructive"
      },
      "shared": {
        "light": "#7A5A91",
        "dark": "#C5A7DC",
        "use": "Movements split with other people (not a debt or a warning)"
      },
      "alert": {
        "light": "#A56B00",
        "dark": "#E5B75D",
        "use": "Near limit and warning states"
      }
    },
    "category": {
      "housing": { "color": "#B96F55", "tint": "#F5E7DE", "icon": "home" },
      "groceries": { "color": "#6E8B58", "tint": "#E8F0E3", "icon": "shopping_cart" },
      "restaurants": { "color": "#D76758", "tint": "#F9E4DF", "icon": "restaurant" },
      "transport": { "color": "#5485B7", "tint": "#E3ECF7", "icon": "directions_car" },
      "leisure": { "color": "#8A6EAA", "tint": "#EEE6F4", "icon": "sports_esports" },
      "subscriptions": { "color": "#4A9793", "tint": "#DEF0EE", "icon": "credit_card" },
      "uncategorized": { "color": "#9E9187", "tint": "#F1EBE4", "icon": "more_horiz" }
    },
    "banner": {
      "info": { "background": "#F0E7EE", "border": "#DFCFE0", "text": "#59385A", "icon": "info" },
      "success": { "background": "#E8F0E3", "border": "#CDDEC1", "text": "#405B32", "icon": "check_circle" },
      "alert": { "background": "#FBF0D9", "border": "#EDD8AE", "text": "#76510B", "icon": "warning" },
      "error": { "background": "#FBE8E5", "border": "#EFCAC4", "text": "#883A35", "icon": "error" }
    },
    "component": {
      "destructiveBorder": "#E8C4BE",
      "toggleOff": "#E7DDD1",
      "toggleOffTrackLight": "#E7DDD1",
      "toggleOffThumbLight": "#66584F",
      "toggleOffBorderLight": "#66584F",
      "toggleDisabledTrackLight": "#EEE6DA",
      "toggleDisabledThumbLight": "#A59588",
      "toggleDisabledBorderLight": "#C7B9AA",
      "toggleOffTrackDark": "#4A3D49",
      "toggleOffThumbDark": "#C9BAC5",
      "toggleOffBorderDark": "#C9BAC5",
      "toggleDisabledTrackDark": "#2B222A",
      "toggleDisabledThumbDark": "#766874",
      "toggleDisabledBorderDark": "#5B4E59",
      "focusRingPlum": "rgba(118,80,119,.12)",
      "desktopWindowChrome": "#F6F0E5",
      "desktopSelectedRowBackground": "#F3EAF1",
      "desktopSelectedRowBorder": "#E2D1E0",
      "desktopActiveNavBackground": "#F0E7EE",
      "chartExpense": "#C77262",
      "scrim": "rgba(51,19,41,.55)"
    }
  },
  "typography": {
    "families": {
      "interface": "Geist, sans-serif",
      "figures": "IBM Plex Mono, monospace"
    },
    "features": {
      "figures": ["tnum"]
    },
    "locale": {
      "currency": "EUR",
      "decimalSeparator": ",",
      "thousandsSeparator": ".",
      "example": "18.420,15 EUR"
    },
    "scale": {
      "display": { "sizePx": 28, "weight": 600, "lineHeight": "default" },
      "title": { "sizePx": 21, "weight": 600, "lineHeight": "default" },
      "heading": { "sizePx": 16, "weight": 600, "lineHeight": "default" },
      "body": { "sizePx": 14, "weight": 500, "lineHeight": "default" },
      "bodySmall": { "sizePx": 13, "weight": 500, "lineHeight": "default" },
      "label": { "sizePx": 12, "weight": 500, "lineHeight": "default" },
      "caption": { "sizePx": 11, "weight": 500, "lineHeight": "default" }
    },
    "tracking": {
      "headingEm": 0,
      "bodyEm": 0
    }
  },
  "spacingPx": [2, 4, 6, 8, 10, 12, 14, 16, 20, 24, 32],
  "radius": {
    "r1": { "px": 7, "use": "Small chips, inputs in rows" },
    "r2": { "px": 10, "use": "Buttons, fields, small cards" },
    "r3": { "px": 14, "use": "Cards, panels" },
    "r4": { "px": 18, "use": "Sheets, large surfaces" },
    "pill": { "px": 999, "use": "Toggles, pill badges" }
  },
  "elevation": {
    "e0": { "shadow": "none", "use": "Default bordered surfaces" },
    "e1": { "shadow": "0 1px 2px rgba(51,19,41,.06)", "use": "Separators" },
    "e2": { "shadow": "0 2px 8px rgba(51,19,41,.06)", "use": "Cards" },
    "e3": { "shadow": "0 8px 18px -6px rgba(118,80,119,.32)", "use": "Button and FAB" },
    "e4": { "shadow": "0 24px 50px -12px rgba(51,19,41,.28)", "use": "Sheets and dialogs" }
  },
  "sizing": {
    "buttonHeightPx": 40,
    "smallButtonHeightPx": 32,
    "fieldHeightPx": 44,
    "iconButtonSizePx": 40,
    "toggleWidthPx": 38,
    "toggleHeightPx": 22,
    "toggleKnobPx": 18,
    "checkboxSizePx": 18,
    "categoryBarHeightPx": 5,
    "budgetBarHeightPx": 6,
    "desktopSidebarWidthPx": 248,
    "desktopMasterListWidthPx": 540,
    "modalMinWidthPx": 344,
    "modalMaxWidthPx": 480,
    "destructiveDialogWidthPx": 312,
    "bottomSheetHandleWidthPx": 34,
    "bottomSheetHandleHeightPx": 4,
    "mobileTouchTargetMinPx": 44
  },
  "icons": {
    "style": "Material Symbols Outlined",
    "weight": 400,
    "fillDefault": 0,
    "fillActiveNavigation": 1,
    "core": [
      "space_dashboard",
      "receipt_long",
      "monitoring",
      "account_balance_wallet",
      "groups",
      "add",
      "search",
      "tune",
      "sort",
      "home",
      "shopping_cart",
      "restaurant",
      "directions_car",
      "sports_esports",
      "credit_card",
      "savings",
      "payments",
      "swap_horiz",
      "handshake",
      "assignment_return",
      "autorenew",
      "trending_up",
      "calendar_month",
      "notifications",
      "settings",
      "warning",
      "error",
      "info",
      "check_circle",
      "north_east",
      "south_west",
      "edit",
      "archive",
      "bolt",
      "lock"
    ]
  },
  "components": {
    "button": {
      "primary": {
        "background": "{colors.brand.plumDefault}",
        "foreground": "{colors.neutral.light.N0}",
        "radius": "{radius.r2}",
        "height": "{sizing.buttonHeightPx}",
        "elevation": "{elevation.e3}"
      },
      "secondary": {
        "background": "{colors.neutral.light.N0}",
        "foreground": "{colors.neutral.light.N900}",
        "border": "{colors.neutral.light.N200}",
        "radius": "{radius.r2}",
        "height": "{sizing.buttonHeightPx}"
      },
      "destructive": {
        "background": "{colors.neutral.light.N0}",
        "foreground": "{colors.functional.debtDanger.light}",
        "border": "{colors.component.destructiveBorder}",
        "radius": "{radius.r2}",
        "height": "{sizing.buttonHeightPx}"
      },
      "disabled": {
        "background": "{colors.neutral.light.N100}",
        "foreground": "{colors.neutral.light.N400}",
        "height": "{sizing.buttonHeightPx}"
      }
    },
    "readOnlyBanner": {
      "background": "{colors.banner.alert.background}",
      "border": "{colors.banner.alert.border}",
      "foreground": "{colors.banner.alert.text}",
      "icon": "lock"
    }
  }
}
