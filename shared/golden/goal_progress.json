{
  "rule": "goal_progress",
  "description": "Savings-goal progress and required monthly pace. A goal funded by a dedicated account takes saved_cents from that account's canonical value; a goal funded by allocations takes it from the signed sum of its active allocations. Neither reading moves the ledger. remaining_cents is the target minus saved, clamped at zero, and reached is true once remaining_cents is zero. Pace exists only when the goal has a target date: months_remaining counts calendar months inclusively from today's month through the target's month, so a target in the current month leaves one month, and monthly_pace_cents divides the remainder over those months rounding up so the target is actually reached. A target date before today is overdue, leaves zero months, and needs the whole remainder now. A reached goal needs no pace.",
  "cases": [
    {
      "name": "dedicated-account goal takes progress from the account value",
      "input": {
        "funding_mode": "dedicated_account",
        "target_amount_cents": 500000,
        "account_balance_cents": 120000,
        "allocation_cents": [],
        "target_date": null,
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 120000,
        "remaining_cents": 380000,
        "reached": false,
        "months_remaining": null,
        "monthly_pace_cents": null,
        "overdue": false
      }
    },
    {
      "name": "allocation goal sums signed allocations and ignores the account value",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 500000,
        "account_balance_cents": 900000,
        "allocation_cents": [
          200000,
          50000,
          -30000
        ],
        "target_date": null,
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 220000,
        "remaining_cents": 280000,
        "reached": false,
        "months_remaining": null,
        "monthly_pace_cents": null,
        "overdue": false
      }
    },
    {
      "name": "monthly pace rounds up so the remainder is fully covered",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 100000,
        "account_balance_cents": 0,
        "allocation_cents": [],
        "target_date": "2026-11-15",
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 0,
        "remaining_cents": 100000,
        "reached": false,
        "months_remaining": 3,
        "monthly_pace_cents": 33334,
        "overdue": false
      }
    },
    {
      "name": "a target in the current month still leaves one month of pace",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 60000,
        "account_balance_cents": 0,
        "allocation_cents": [
          15000
        ],
        "target_date": "2026-09-30",
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 15000,
        "remaining_cents": 45000,
        "reached": false,
        "months_remaining": 1,
        "monthly_pace_cents": 45000,
        "overdue": false
      }
    },
    {
      "name": "a past target month is overdue and needs the whole remainder now",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 60000,
        "account_balance_cents": 0,
        "allocation_cents": [
          15000
        ],
        "target_date": "2026-07-31",
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 15000,
        "remaining_cents": 45000,
        "reached": false,
        "months_remaining": 0,
        "monthly_pace_cents": 45000,
        "overdue": true
      }
    },
    {
      "name": "exceeding the target clamps the remainder and needs no pace",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 500000,
        "account_balance_cents": 0,
        "allocation_cents": [
          300000,
          300000
        ],
        "target_date": "2027-01-31",
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 600000,
        "remaining_cents": 0,
        "reached": true,
        "months_remaining": 5,
        "monthly_pace_cents": 0,
        "overdue": false
      }
    },
    {
      "name": "an emptied dedicated account reports no progress",
      "input": {
        "funding_mode": "dedicated_account",
        "target_amount_cents": 250000,
        "account_balance_cents": 0,
        "allocation_cents": [],
        "target_date": "2026-12-31",
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 0,
        "remaining_cents": 250000,
        "reached": false,
        "months_remaining": 4,
        "monthly_pace_cents": 62500,
        "overdue": false
      }
    },
    {
      "name": "an overdue reached goal is complete rather than overdue",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 40000,
        "account_balance_cents": 0,
        "allocation_cents": [
          40000
        ],
        "target_date": "2026-06-30",
        "today": "2026-09-03"
      },
      "expected": {
        "saved_cents": 40000,
        "remaining_cents": 0,
        "reached": true,
        "months_remaining": 0,
        "monthly_pace_cents": 0,
        "overdue": false
      }
    },
    {
      "name": "a passed date in the current month is overdue",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 60000,
        "account_balance_cents": 0,
        "allocation_cents": [
          15000
        ],
        "target_date": "2026-09-05",
        "today": "2026-09-20"
      },
      "expected": {
        "saved_cents": 15000,
        "remaining_cents": 45000,
        "reached": false,
        "months_remaining": 0,
        "monthly_pace_cents": 45000,
        "overdue": true
      }
    },
    {
      "name": "a target today still has one funding period",
      "input": {
        "funding_mode": "allocations",
        "target_amount_cents": 60000,
        "account_balance_cents": 0,
        "allocation_cents": [
          15000
        ],
        "target_date": "2026-09-20",
        "today": "2026-09-20"
      },
      "expected": {
        "saved_cents": 15000,
        "remaining_cents": 45000,
        "reached": false,
        "months_remaining": 1,
        "monthly_pace_cents": 45000,
        "overdue": false
      }
    }
  ]
}
