{
  "rule": "account_flow",
  "description": "current_balance per account = starting_balance + Σ flow from v_account_balance. Everything counts; a transfer is dual-signed (−origin, +destination); settlement sign follows direction; refund is an inflow at amount_cents.",
  "cases": [
    {
      "name": "all movement types across two accounts",
      "input": {
        "accounts": [
          { "id": "acc-1", "starting_balance_cents": 10000 },
          { "id": "acc-2", "starting_balance_cents": 0 }
        ],
        "movements": [
          { "id": "mv1", "type": "expense",    "account_id": "acc-1", "amount_cents": 3000, "date": "2026-03-01" },
          { "id": "mv2", "type": "income",     "account_id": "acc-1", "amount_cents": 5000, "date": "2026-03-02" },
          { "id": "mv3", "type": "transfer",   "account_id": "acc-1", "dest_account_id": "acc-2", "amount_cents": 2000, "date": "2026-03-03" },
          { "id": "mv4", "type": "refund",     "account_id": "acc-1", "amount_cents": 1000, "date": "2026-03-04", "refunds_expense_id": "mv1" },
          { "id": "mv5", "type": "settlement", "account_id": "acc-1", "amount_cents": 1500, "date": "2026-03-05", "person_id": "pA", "settlement_direction": "person_to_user" },
          { "id": "mv6", "type": "settlement", "account_id": "acc-2", "amount_cents": 500,  "date": "2026-03-06", "person_id": "pB", "settlement_direction": "user_to_person" },
          { "id": "mv7", "type": "expense", "payer_person_id": "pC", "amount_cents": 4000, "date": "2026-03-07" }
        ]
      },
      "expected": {
        "current_balance_cents": { "acc-1": 12500, "acc-2": 1500 },
        "net_worth_cents": 14000,
        "explain": {
          "acc-1": "10000 -3000 +5000 -2000(transfer out) +1000 +1500 = 12500",
          "acc-2": "0 +2000(transfer in) -500 = 1500",
          "mv7": "Paid by pC: no account moves"
        }
      }
    }
  ]
}
